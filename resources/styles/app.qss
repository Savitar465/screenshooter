/* QAflow · hoja de estilos. Los "role" son propiedades dinámicas fijadas desde ui::setRole().
   Los colores son tokens (@bg, @tint(green,30)…) que theme::stylesheet() sustituye por la paleta
   activa (oscura o clara); ver presentation/theme/Theme.cpp. */

* { outline: none; }

QWidget {
    background: transparent;
    color: @text;
    font-size: 13px;
}
QMainWindow, #central {
    background: qradialgradient(cx:0.15, cy:-0.1, radius:1.1, fx:0.15, fy:-0.1, stop:0 @gradient-top, stop:0.55 @bg, stop:1 @bg);
}
QDialog, QMessageBox, QInputDialog, QFileDialog { background: @panel; }
QToolTip { background: @elevated; color: @text; border: 1px solid @border; padding: 4px 8px; }

/* ---- Menú y bandeja ---- */
QMenuBar { background: @panel; border-bottom: 1px solid @border; padding: 2px 6px; }
QMenuBar::item { padding: 5px 10px; border-radius: 6px; color: @muted; background: transparent; }
QMenuBar::item:selected, QMenuBar::item:pressed { background: @elevated; color: @text; }
QMenu { background: @elevated; border: 1px solid @border; border-radius: 8px; padding: 6px; }
QMenu::item { padding: 6px 28px 6px 12px; border-radius: 6px; color: @text; }
QMenu::item:selected { background: @tint(blue,45); }
QMenu::item:disabled { color: @disabled; }
QMenu::separator { height: 1px; background: @border; margin: 5px 8px; }
QMenu::indicator { width: 14px; height: 14px; }

/* ---- Texto ---- */
QLabel[role="eyebrow"] { font-size: 11px; font-weight: 700; color: @muted; letter-spacing: 1px; text-transform: uppercase; }
QLabel[role="eyebrow-mono"] { font-size: 11px; font-weight: 700; color: @muted; letter-spacing: 1px; font-family: "Consolas", "DejaVu Sans Mono", monospace; }
QLabel[role="h1"] { font-size: 24px; font-weight: 800; }
QLabel[role="h1-sm"] { font-size: 18px; font-weight: 800; }
QLabel[role="h2"] { font-size: 17px; font-weight: 800; }
QLabel[role="muted"] { color: @muted; }
QLabel[role="muted-sm"] { color: @muted; font-size: 12px; }
QLabel[role="mono-muted"] { color: @muted; font-family: "Consolas", "DejaVu Sans Mono", monospace; font-size: 11px; font-weight: 700; }
QLabel[role="stat"] { font-size: 20px; font-weight: 800; }
QLabel[role="warn"] { color: @amber-soft; font-weight: 600; font-size: 11.5px; }
QLabel[role="pill"] { border-radius: 9px; padding: 1px 7px; font-size: 11px; font-weight: 700; }

/* ---- Contenedores ---- */
QFrame[role="card"] { background: @panel; border: 1px solid @border; border-radius: 12px; }
QFrame[role="card-elevated"] { background: @elevated; border: 1px solid @border; border-radius: 12px; }
QFrame[role="card-flat"] { background: @elevated; border: none; border-radius: 8px; }
QFrame[role="card-lg"] { background: @panel; border: 1px solid @border; border-radius: 16px; }
QFrame[role="card-run"] { background: @panel; border: 2px solid @green; border-radius: 16px; }
QFrame[role="rail"] { background: @panel; border-right: 1px solid @border; }
QFrame[role="status-strip"] { background: @panel; border-top: 1px solid @border; }
QFrame[role="list-pane"] { background: @panel-translucent; border-right: 1px solid @border; }
QFrame[role="grid-cell"] { background: @elevated; border: 1px solid @border; border-radius: 8px; }
QFrame[role="accent"] { border-radius: 2px; border: none; }
/* Paso de la lista de la ejecución: el activo se resalta */
QFrame[role="step-card"] { background: transparent; border: 1px solid transparent; border-radius: 10px; }
QFrame[role="step-card"][active="true"] { background: @elevated; border-color: @blue; }
/* Pie de un diálogo (Ajustes): separa el contenido de los botones de cierre. */
QFrame[role="dialog-footer"] { background: @panel; border-top: 1px solid @border; }

/* ---- Botones ---- */
QPushButton { border-radius: 9px; padding: 8px 14px; font-weight: 700; font-size: 13px; border: 1px solid transparent; }
QPushButton:disabled { color: @disabled; }

QPushButton[role="primary"] { background: @blue; color: @on-accent; }
QPushButton[role="primary"]:hover { background: @blue-hover; }
QPushButton[role="success"] { background: @green; color: @on-accent; }
QPushButton[role="success"]:hover { background: @green-hover; }
QPushButton[role="danger"] { background: @red; color: #ffffff; }
QPushButton[role="danger"]:hover { background: @red-hover; }
QPushButton[role="warning-outline"] { background: @elevated; color: @amber; border: 1px solid @amber; }
QPushButton[role="warning-outline"]:hover { background: @tint(amber,30); }
QPushButton[role="outline"] { background: @elevated; color: @text; border: 1px solid @border; }
QPushButton[role="outline"]:hover { border-color: @blue; }
QPushButton[role="ghost"] { background: transparent; color: @muted; border: 1px solid @border; }
QPushButton[role="ghost"]:hover { color: @text; }

/* Veredictos de la pantalla de Ejecución: los cuatro comparten el mismo peso visual
   para que "Bloqueado" y "Saltar" se lean como botones y no como texto suelto. */
QPushButton[role="verdict-block"] { background: @tint(amber,45); color: @amber-soft; border: 1px solid @amber; }
QPushButton[role="verdict-block"]:hover { background: @tint(amber,80); }
QPushButton[role="verdict-skip"] { background: @elevated; color: @text-soft; border: 1px solid @muted; }
QPushButton[role="verdict-skip"]:hover { background: @tint(muted,45); border-color: @text-soft; }
QPushButton[role="dashed"] { background: transparent; color: @blue; border: 1px dashed @border; padding: 5px 10px; font-size: 12px; border-radius: 8px; }
QPushButton[role="dashed"]:hover { border-color: @blue; background: @tint(blue,15); }
QPushButton[role="chip"] { background: transparent; color: @muted; border: 1px solid @border; border-radius: 999px; padding: 3px 9px; font-size: 11.5px; font-weight: 600; }
QPushButton[role="chip"]:hover { border-color: @blue; }
QPushButton[role="chip"][active="true"] { background: @tint(blue,30); color: @blue; border-color: @blue; }
QPushButton[role="chip-lg"] { background: transparent; color: @text; border: 1px solid @border; border-radius: 999px; padding: 4px 12px; font-size: 12px; font-weight: 600; }
QPushButton[role="chip-lg"]:hover { border-color: @blue; }
QPushButton[role="icon"] { background: transparent; border: none; color: @muted; padding: 0 4px; font-size: 16px; border-radius: 6px; }
QPushButton[role="icon"]:hover { color: @red; background: @tint(red,20); }
QPushButton[role="icon-move"] { background: transparent; border: 1px solid @border; color: @muted; padding: 2px 6px; font-size: 10px; border-radius: 5px; }
QPushButton[role="icon-move"]:hover { color: @blue; border-color: @blue; }
QPushButton[role="icon-plain"] { background: transparent; border: none; color: @muted; padding: 2px 4px; font-size: 11px; }
QPushButton[role="icon-plain"]:hover { color: @blue; }

/* Navegación lateral */
QPushButton[role="nav"] { text-align: left; padding: 9px 10px; border-radius: 10px; background: transparent; color: @muted; border: 1px solid transparent; font-size: 13.5px; font-weight: 600; }
QPushButton[role="nav"]:hover { background: @elevated; }
QPushButton[role="nav"][active="true"] { background: @elevated; color: @text; border-color: @border; }

/* Filas de listas (casos, plan) */
QPushButton[role="row"] { text-align: left; background: transparent; border: 1px solid transparent; border-radius: 10px; padding: 0; }
QPushButton[role="row"]:hover { background: @elevated; }
QPushButton[role="row"][active="true"] { background: @elevated; border-color: @blue; }
QPushButton[role="row"][running="true"] { background: @tint(green,20); border-color: @green; }
QPushButton[role="plan-row"] { text-align: left; background: transparent; border: 1px solid @border; border-radius: 10px; padding: 0; }
QPushButton[role="plan-row"]:hover { background: @elevated; }
QPushButton[role="plan-row"][active="true"] { background: @tint(green,15); border-color: @tint(green,90); }

/* Rail de navegación (iconos) y bloques de la barra de estado */
QPushButton[role="rail-nav"] { background: transparent; border: none; border-radius: 10px; padding: 0; }
QPushButton[role="rail-nav"]:hover { background: @elevated; }
QPushButton[role="rail-nav"][active="true"] { background: @elevated; }
QPushButton[role="status-item"] { background: transparent; border: 1px solid transparent; border-radius: 8px; padding: 0; }
QPushButton[role="status-item"]:hover { background: @elevated; border-color: @border; }

/* Badge del gestor (conectado / desconectado) */
QPushButton[role="badge"] { border-radius: 999px; padding: 5px 12px; font-size: 12px; font-weight: 700; }
QPushButton[role="badge"][active="true"] { background: @tint(green,30); border: 1px solid @tint(green,100); color: @green; }
QPushButton[role="badge"][active="false"] { background: @tint(red,30); border: 1px solid @tint(red,100); color: @red; }

/* ---- Campos ---- */
QLineEdit, QPlainTextEdit, QComboBox {
    background: @field; border: 1px solid @border; border-radius: 9px; padding: 7px 12px; font-size: 13px; selection-background-color: @blue; selection-color: @on-accent;
}
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border-color: @blue; }
QLineEdit[invalid="true"], QPlainTextEdit[invalid="true"] { border-color: @red; }
QLineEdit[role="title"] { background: transparent; border: 1px solid transparent; border-radius: 8px; padding: 6px 8px; font-size: 24px; font-weight: 800; }
QLineEdit[role="title"]:hover { border-color: @border; }
QLineEdit[role="title"]:focus { border-color: @blue; }
QLineEdit[role="mono"] { font-family: "Consolas", "DejaVu Sans Mono", monospace; }
QPlainTextEdit[role="mono"] { font-family: "Consolas", "DejaVu Sans Mono", monospace; }
QPlainTextEdit[role="panel"] { background: @panel; border-radius: 10px; }
QPlainTextEdit[role="danger-soft"] { background: @tint(red,15); border-color: @tint(red,90); }
QPlainTextEdit[role="danger-soft"][invalid="true"] { border-color: @red; }
QComboBox { padding: 5px 8px; border-radius: 7px; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox::down-arrow { image: none; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid @muted; margin-right: 8px; }
QComboBox QAbstractItemView { background: @elevated; border: 1px solid @border; selection-background-color: @border; selection-color: @text; padding: 4px; outline: 0; }
QComboBox[role="small"] { font-size: 12px; padding: 3px 6px; border-radius: 6px; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid @border; border-radius: 4px; background: @field; }
QCheckBox::indicator:checked { background: @blue; border-color: @blue; }

/* ---- Scroll ---- */
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: @border; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: @scroll-hover; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: @border; border-radius: 5px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---- Progreso ---- */
QProgressBar { background: @field; border: none; border-radius: 3px; max-height: 6px; min-height: 6px; text-align: center; }
QProgressBar::chunk { background: @green; border-radius: 3px; }

/* ---- Toast ---- */
QFrame[role="toast"] { background: @elevated; border: 1px solid @border; border-radius: 10px; }
QFrame[role="toast"] QLabel { font-weight: 600; font-size: 13px; }

/* Botones con menú desplegable: sin flecha indicadora (el "⋯" ya lo sugiere). */
QPushButton::menu-indicator { image: none; width: 0px; }

/* Barra de proyectos y ejecución */
QFrame#ideNavbar { background: @panel; border: none; border-bottom: 1px solid @border; border-radius: 0; }
QPushButton#navbarRun:disabled, QPushButton#navbarStop:disabled { background: @elevated; color: @disabled; border-color: @border; }
QComboBox#runTargetSelector:disabled, QComboBox#projectSelector:disabled { color: @muted; }
