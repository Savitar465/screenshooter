/* QAflow · tema oscuro. Los "role" son propiedades dinámicas fijadas desde ui::setRole(). */

* { outline: none; }

QWidget {
    background: transparent;
    color: #e6edf3;
    font-size: 13px;
}
QMainWindow, #central {
    background: qradialgradient(cx:0.15, cy:-0.1, radius:1.1, fx:0.15, fy:-0.1, stop:0 #1a2130, stop:0.55 #0e1116, stop:1 #0e1116);
}
QToolTip { background: #1c232d; color: #e6edf3; border: 1px solid #2a3441; padding: 4px 8px; }

/* ---- Texto ---- */
QLabel[role="eyebrow"] { font-size: 11px; font-weight: 700; color: #9aa7b4; letter-spacing: 1px; text-transform: uppercase; }
QLabel[role="eyebrow-mono"] { font-size: 11px; font-weight: 700; color: #9aa7b4; letter-spacing: 1px; font-family: "Consolas", "DejaVu Sans Mono", monospace; }
QLabel[role="h1"] { font-size: 24px; font-weight: 800; }
QLabel[role="h1-sm"] { font-size: 18px; font-weight: 800; }
QLabel[role="h2"] { font-size: 17px; font-weight: 800; }
QLabel[role="muted"] { color: #9aa7b4; }
QLabel[role="muted-sm"] { color: #9aa7b4; font-size: 12px; }
QLabel[role="mono-muted"] { color: #9aa7b4; font-family: "Consolas", "DejaVu Sans Mono", monospace; font-size: 11px; font-weight: 700; }
QLabel[role="stat"] { font-size: 20px; font-weight: 800; }
QLabel[role="warn"] { color: #fbbf24; font-weight: 600; font-size: 11.5px; }
QLabel[role="pill"] { border-radius: 9px; padding: 1px 7px; font-size: 11px; font-weight: 700; }

/* ---- Contenedores ---- */
QFrame[role="card"] { background: #161b22; border: 1px solid #2a3441; border-radius: 12px; }
QFrame[role="card-elevated"] { background: #1c232d; border: 1px solid #2a3441; border-radius: 12px; }
QFrame[role="card-flat"] { background: #1c232d; border: none; border-radius: 8px; }
QFrame[role="card-lg"] { background: #161b22; border: 1px solid #2a3441; border-radius: 16px; }
QFrame[role="card-run"] { background: #161b22; border: 2px solid #10b981; border-radius: 16px; }
QFrame[role="sidebar"] { background: #161b22; border-right: 1px solid #2a3441; }
QFrame[role="list-pane"] { background: rgba(22,27,34,153); border-right: 1px solid #2a3441; }
QFrame[role="grid-cell"] { background: #1c232d; border: 1px solid #2a3441; border-radius: 8px; }
QFrame[role="accent"] { border-radius: 2px; border: none; }

/* ---- Botones ---- */
QPushButton { border-radius: 9px; padding: 8px 14px; font-weight: 700; font-size: 13px; border: 1px solid transparent; }
QPushButton:disabled { color: #5c6876; }

QPushButton[role="primary"] { background: #6ea8fe; color: #0e1116; }
QPushButton[role="primary"]:hover { background: #9db8f0; }
QPushButton[role="success"] { background: #10b981; color: #0e1116; }
QPushButton[role="success"]:hover { background: #34d399; }
QPushButton[role="danger"] { background: #ef4444; color: #ffffff; }
QPushButton[role="danger"]:hover { background: #f87171; }
QPushButton[role="warning-outline"] { background: #1c232d; color: #f59e0b; border: 1px solid #f59e0b; }
QPushButton[role="warning-outline"]:hover { background: rgba(245,158,11,30); }
QPushButton[role="outline"] { background: #1c232d; color: #e6edf3; border: 1px solid #2a3441; }
QPushButton[role="outline"]:hover { border-color: #6ea8fe; }
QPushButton[role="ghost"] { background: transparent; color: #9aa7b4; border: 1px solid #2a3441; }
QPushButton[role="ghost"]:hover { color: #e6edf3; }
QPushButton[role="dashed"] { background: transparent; color: #6ea8fe; border: 1px dashed #2a3441; padding: 5px 10px; font-size: 12px; border-radius: 8px; }
QPushButton[role="dashed"]:hover { border-color: #6ea8fe; background: rgba(110,168,254,15); }
QPushButton[role="chip"] { background: transparent; color: #9aa7b4; border: 1px solid #2a3441; border-radius: 999px; padding: 3px 9px; font-size: 11.5px; font-weight: 600; }
QPushButton[role="chip"]:hover { border-color: #6ea8fe; }
QPushButton[role="chip"][active="true"] { background: rgba(110,168,254,30); color: #6ea8fe; border-color: #6ea8fe; }
QPushButton[role="chip-lg"] { background: transparent; color: #e6edf3; border: 1px solid #2a3441; border-radius: 999px; padding: 4px 12px; font-size: 12px; font-weight: 600; }
QPushButton[role="chip-lg"]:hover { border-color: #6ea8fe; }
QPushButton[role="icon"] { background: transparent; border: none; color: #9aa7b4; padding: 0 4px; font-size: 16px; border-radius: 6px; }
QPushButton[role="icon"]:hover { color: #ef4444; background: rgba(239,68,68,20); }
QPushButton[role="icon-move"] { background: transparent; border: 1px solid #2a3441; color: #9aa7b4; padding: 2px 6px; font-size: 10px; border-radius: 5px; }
QPushButton[role="icon-move"]:hover { color: #6ea8fe; border-color: #6ea8fe; }
QPushButton[role="icon-plain"] { background: transparent; border: none; color: #9aa7b4; padding: 2px 4px; font-size: 11px; }
QPushButton[role="icon-plain"]:hover { color: #6ea8fe; }

/* Navegación lateral */
QPushButton[role="nav"] { text-align: left; padding: 9px 10px; border-radius: 10px; background: transparent; color: #9aa7b4; border: 1px solid transparent; font-size: 13.5px; font-weight: 600; }
QPushButton[role="nav"]:hover { background: #1c232d; }
QPushButton[role="nav"][active="true"] { background: #1c232d; color: #e6edf3; border-color: #2a3441; }

/* Filas de listas (casos, plan) */
QPushButton[role="row"] { text-align: left; background: transparent; border: 1px solid transparent; border-radius: 10px; padding: 0; }
QPushButton[role="row"]:hover { background: #1c232d; }
QPushButton[role="row"][active="true"] { background: #1c232d; border-color: #6ea8fe; }
QPushButton[role="row"][running="true"] { background: rgba(16,185,129,20); border-color: #10b981; }
QPushButton[role="plan-row"] { text-align: left; background: transparent; border: 1px solid #2a3441; border-radius: 10px; padding: 0; }
QPushButton[role="plan-row"]:hover { background: #1c232d; }
QPushButton[role="plan-row"][active="true"] { background: rgba(16,185,129,15); border-color: rgba(16,185,129,90); }

/* Tarjeta "En ejecución" del sidebar */
QPushButton[role="running-card"] { text-align: left; background: rgba(16,185,129,25); border: 1px solid #10b981; border-radius: 12px; padding: 0; }
QPushButton[role="running-card"]:hover { background: rgba(16,185,129,40); }

/* Badge Jira (conectado / desconectado) */
QPushButton[role="badge"] { border-radius: 999px; padding: 5px 12px; font-size: 12px; font-weight: 700; }
QPushButton[role="badge"][active="true"] { background: rgba(16,185,129,30); border: 1px solid rgba(16,185,129,100); color: #10b981; }
QPushButton[role="badge"][active="false"] { background: rgba(239,68,68,30); border: 1px solid rgba(239,68,68,100); color: #ef4444; }

/* ---- Campos ---- */
QLineEdit, QPlainTextEdit, QComboBox {
    background: #0e1116; border: 1px solid #2a3441; border-radius: 9px; padding: 7px 12px; font-size: 13px; selection-background-color: #6ea8fe; selection-color: #0e1116;
}
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border-color: #6ea8fe; }
QLineEdit[invalid="true"], QPlainTextEdit[invalid="true"] { border-color: #ef4444; }
QLineEdit[role="title"] { background: transparent; border: 1px solid transparent; border-radius: 8px; padding: 6px 8px; font-size: 24px; font-weight: 800; }
QLineEdit[role="title"]:hover { border-color: #2a3441; }
QLineEdit[role="title"]:focus { border-color: #6ea8fe; }
QLineEdit[role="mono"] { font-family: "Consolas", "DejaVu Sans Mono", monospace; }
QPlainTextEdit[role="mono"] { font-family: "Consolas", "DejaVu Sans Mono", monospace; }
QPlainTextEdit[role="panel"] { background: #161b22; border-radius: 10px; }
QPlainTextEdit[role="danger-soft"] { background: rgba(239,68,68,15); border-color: rgba(239,68,68,90); }
QPlainTextEdit[role="danger-soft"][invalid="true"] { border-color: #ef4444; }
QComboBox { padding: 5px 8px; border-radius: 7px; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox::down-arrow { image: none; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid #9aa7b4; margin-right: 8px; }
QComboBox QAbstractItemView { background: #1c232d; border: 1px solid #2a3441; selection-background-color: #2a3441; selection-color: #e6edf3; padding: 4px; outline: 0; }
QComboBox[role="small"] { font-size: 12px; padding: 3px 6px; border-radius: 6px; }

/* ---- Scroll ---- */
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #2a3441; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #3a4656; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #2a3441; border-radius: 5px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---- Progreso ---- */
QProgressBar { background: #0e1116; border: none; border-radius: 3px; max-height: 6px; min-height: 6px; text-align: center; }
QProgressBar::chunk { background: #10b981; border-radius: 3px; }

/* ---- Toast ---- */
QFrame[role="toast"] { background: #1c232d; border: 1px solid #2a3441; border-radius: 10px; }
QFrame[role="toast"] QLabel { font-weight: 600; font-size: 13px; }

/* Botones con menú desplegable: sin flecha indicadora (el "⋯" ya lo sugiere). */
QPushButton::menu-indicator { image: none; width: 0px; }
